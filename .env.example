# Optional same-origin Node server. The free library needs no credentials.
PORT=3000
HOST=127.0.0.1
DOMAIN=http://localhost:3000
# Set HOST=0.0.0.0 only when required by your hosting provider.
# Set DOMAIN to the public HTTPS origin before enabling checkout.

ANTHROPIC_API_KEY=
# Select a model available to your Anthropic account.
ANTHROPIC_MODEL=claude-opus-4-5

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# USD 5.00 recurring each month, with no trial or automatic tax:
STRIPE_PRICE_MONTHLY=
# USD 40.00 one-time:
STRIPE_PRICE_LIFETIME=
# A random secret of at least 32 characters. Keep stable across deployments.
ACCESS_TOKEN_SECRET=
# Set only to the exact number of trusted proxies in front of this server.
TRUST_PROXY_HOPS=0
