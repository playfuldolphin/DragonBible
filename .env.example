# Dragon Bible Environment Variables
# Copy this file to .env and fill in your actual values

# Anthropic (AI Lore Oracle)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Stripe Keys (Get from https://dashboard.stripe.com/apikeys)
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (Create products in Stripe dashboard first)
# DM Subscription: $5/month recurring
STRIPE_PRICE_MONTHLY=price_your_monthly_5_id
# Founding DM: $40 one-time payment
STRIPE_PRICE_LIFETIME=price_your_lifetime_40_id

# Server Configuration
PORT=3000
DOMAIN=http://localhost:3000

# Firebase Configuration (Optional - for user authentication)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef

# Email Service (Optional - for email automation)
MAILCHIMP_API_KEY=your_mailchimp_key
CONVERTKIT_API_KEY=your_convertkit_key

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
